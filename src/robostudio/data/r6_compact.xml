<!-- Original RoboStudio idealized 6R model. Project-authored; unreleased.
     SI units, radians; capsule-derived inertia, no contact geometry.
     Joint axes/zero pose match the independently defined Python FK. -->
<mujoco model="RoboStudio R6 Compact">
  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint type="hinge" damping="2" armature="0.02" limited="true"/>
    <geom type="capsule" size="0.035" contype="0" conaffinity="0"/>
    <motor gear="1" ctrllimited="true"/>
  </default>
  <worldbody>
    <body name="link1">
      <joint name="joint1" axis="0 0 1" range="-3.141592653589793 3.141592653589793"/>
      <geom fromto="0 0 0 0 0 0.22" mass="3"/>
      <body name="link2" pos="0 0 0.22">
        <joint name="joint2" axis="0 1 0" range="-2.0943951023931953 2.0943951023931953"/>
        <geom fromto="0 0 0 0.32 0 0" mass="2.5"/>
        <body name="link3" pos="0.32 0 0">
          <joint name="joint3" axis="0 1 0" range="-2.443460952792061 2.443460952792061"/>
          <geom fromto="0 0 0 0.28 0 0" mass="1.8"/>
          <body name="link4" pos="0.28 0 0">
            <joint name="joint4" axis="1 0 0" range="-3.141592653589793 3.141592653589793"/>
            <geom fromto="0 0 0 0.07 0 0" mass="0.5" size="0.028"/>
            <body name="link5" pos="0.07 0 0">
              <joint name="joint5" axis="0 1 0" range="-2.0943951023931953 2.0943951023931953"/>
              <geom fromto="0 0 0 0.07 0 0" mass="0.4" size="0.025"/>
              <body name="link6" pos="0.07 0 0">
                <joint name="joint6" axis="1 0 0" range="-3.141592653589793 3.141592653589793"/>
                <geom fromto="0 0 0 0.1 0 0" mass="0.3" size="0.02"/>
                <site name="tcp" pos="0.1 0 0" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- Deliberate non-joint ordering exercises explicit ctrl mapping. -->
    <motor name="motor2" joint="joint2" ctrlrange="-100 100"/>
    <motor name="motor1" joint="joint1" ctrlrange="-100 100"/>
    <motor name="motor3" joint="joint3" ctrlrange="-60 60"/>
    <motor name="motor4" joint="joint4" ctrlrange="-20 20"/>
    <motor name="motor5" joint="joint5" ctrlrange="-20 20"/>
    <motor name="motor6" joint="joint6" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
